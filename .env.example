# =============================================================
# Cá Cảnh Thanh Liêm — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================

# ── Application ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cacanhthanhliem.vn

# ── Supabase ──────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API Keys
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  = "Publishable key" (legacy name: anon)
#   SUPABASE_SERVICE_ROLE_KEY      = "Secret key" (legacy name: service_role)
#                                    Server-only. Never prefix it NEXT_PUBLIC_.
#
# When left as placeholders the site shows sample data and the admin
# panel cannot save anything (local preview only).
# With real values the site reads only from the database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Email (Resend) — contact form ─────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here
# Inbox that receives contact-form messages (comma-separate several).
# Currently the developer's address for testing — switch to the shop
# owner's address at hand-over.
CONTACT_TO_EMAIL=baolam101101@gmail.com
# Sender. Leave unset to use Resend's test sender, which can only deliver
# to the email of the Resend account itself. To send to any address,
# verify the domain in Resend first, then e.g.:
# RESEND_FROM=Cá Cảnh Thanh Liêm <lienhe@cacanhthanhliem.vn>

# ── Admin auth ────────────────────────────────────────────────
# Secret used to sign admin session cookies. REQUIRED in production:
# at least 32 characters; admin sign-in is refused without it.
# Generate: openssl rand -base64 48
SESSION_SECRET=change_this_to_a_long_random_string_min_32_chars

# ── Analytics (optional) ─────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
